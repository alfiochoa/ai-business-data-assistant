# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string. Local docker-compose:
#   postgresql://postgres:postgres@localhost:5432/northstar
# Supabase: Project Settings -> Database -> Connection string -> URI (pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/northstar

# Primary LLM: any OpenAI-compatible provider. Default is Groq's free tier
# (key from https://console.groq.com/keys, no credit card).
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional fallback, used automatically on rate limits / provider errors.
# Hugging Face router (free token with "Inference Providers" permission):
#LLM_FALLBACK_BASE_URL=https://router.huggingface.co/v1
#LLM_FALLBACK_API_KEY=hf_...
#LLM_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct
# ...or local Ollama (no key needed):
#LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
#LLM_FALLBACK_MODEL=llama3.1
